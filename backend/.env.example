# Backend environment variables

# Required:
OPENAI_API_KEY=

# Optional (for OpenAI-compatible providers or self-hosted gateways)
# Examples:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Default chat model (optional)
# e.g., gpt-4o-mini, gpt-4o, o3-mini, llama3.1
OPENAI_MODEL=gpt-4o-mini

# Logging
# Set log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: bearer token for remote exercises JSON
EXERCISES_BEARER_TOKEN=

# SSL settings for fetching remote exercises JSON
# If you encounter certificate verify failures in certain environments,
# you can either point to a custom CA bundle, or temporarily disable verification (not recommended).
# Path to a PEM CA bundle (defaults to certifi bundle when installed)
EXERCISES_CA_BUNDLE=
# Set to false to bypass SSL verification (use only for local debugging)
EXERCISES_SSL_VERIFY=true
